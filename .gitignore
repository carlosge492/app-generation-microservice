__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.env

# Deployment configuration: holds the Anthropic key and the receiving address.
.env.deploy

# Agent output — build artifacts, not source
generated_apps/

# Payer private keys. The testnet one is throwaway and must never be reused on
# mainnet; a mainnet payer file holds a key with real money behind it. The glob
# covers both, so a new key file is ignored the moment it is created rather than
# when someone remembers to add it.
.x402-*.json

# Runtime logs from the emulator suite, not part of its config.
emulator/*-debug.log
