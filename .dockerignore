# Generated apps are gigabytes of Gradle output and belong to a build, not the
# image. Sending them would also ship whatever a previous buyer's PRD produced.
generated_apps/
emulator/

# Keys. These hold funded private keys — the testnet payer, and any mainnet
# payer file created for a live purchase. Gitignored, and they must not reach an
# image either. Globbed so a new key file is excluded on creation.
.env
.env.deploy
.x402-*.json

.git/
.github/
.pytest_cache/
**/__pycache__/
*.pyc

# The image runs the service. Tests, evals and the verification scripts need a
# browser, an emulator and a JDK 21, none of which belong in a production image.
tests/
evals/
scripts/
docs/
