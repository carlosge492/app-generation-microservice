# Deployment configuration. Copy to `.env.deploy`, fill in the two blanks, and
#
#   docker compose --env-file .env.deploy up -d --build
#
# `.env.deploy` is gitignored. Nothing in this file is a secret except
# ANTHROPIC_API_KEY — the x402 values are public chain parameters, and the
# service holds no signing keys of its own (see src/build/signing.py for why the
# APK ships unsigned).

# --- x402 ---------------------------------------------------------------------
# Base Sepolia. Verified end to end on this configuration: a real transaction,
# a real APK, and no real money at stake.
X402_TOKEN_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_CHAIN_ID=84532
X402_NETWORK=base-sepolia
X402_PRICE_ATOMIC=3000000

# For Base **mainnet**, all four of these change together:
#
#   X402_TOKEN_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   X402_CHAIN_ID=8453
#   X402_NETWORK=base
#   X402_DOMAIN_NAME=USD Coin
#
# That last line is the one that gets missed. The EIP-712 domain name defaults
# to "USDC", which is right for Base Sepolia's test token and wrong for mainnet
# USDC, whose domain name is "USD Coin". Get it wrong and every buyer's
# signature is computed over a different domain than the service checks, so all
# of them are rejected — it fails closed, but it looks like a broken deployment
# rather than a one-word mistake. `verify_deployment.py` refuses a deployment
# whose chain, contract and domain do not agree.
#
# Real money changes what a bug costs. Nothing in this repo's verification
# history involved funds with value.

# The address that receives payment. There is no default: a wrong value here
# sends every buyer's money somewhere you do not control, and an empty one makes
# the service refuse payment outright rather than accept it into the void.
X402_PAY_TO=

# Public facilitator, no auth. It submits the authorization on-chain and pays
# gas, which is what lets a buyer pay in USDC with no ETH. Leave it set: without
# it the service accepts signed promises it never settles, and /healthz will say
# so with `settlement: verification-only`.
X402_FACILITATOR_URL=https://facilitator.payai.network

# --- generation ---------------------------------------------------------------
# The service defaults to the Claude generator, so this is required for the
# deployment to produce anything. A sweep costs real money; see the README on
# what generation runs cost before pointing traffic at this.
ANTHROPIC_API_KEY=

# `template` is the deterministic generator: no API key, no spend, and it still
# exercises the whole pipeline through to an APK. Useful for a first deploy.
SUPERVISOR_GENERATOR=claude

# Which model the `claude` generator uses. Empty means the code's own default
# (claude-opus-5). This is the single biggest lever on both cost per build and
# whether the build succeeds at all — the payment settles *before* the build
# runs, so a model that cannot produce clean Dart takes the buyer's money and
# then fails. Validate a model against the eval sweep before selling with it.
SUPERVISOR_MODEL=

# `debug` produces an installable APK. `release` produces an unsigned one the
# buyer signs with their own key, which is the honest artifact for resale but
# not installable as delivered.
SUPERVISOR_BUILD_MODE=debug

LOG_LEVEL=INFO

# --- public address -----------------------------------------------------------
# The hostname the TLS proxy answers on and requests a certificate for. It must
# already resolve to this machine before the stack starts: Let's Encrypt proves
# control by connecting back, so a name that does not point here yet fails the
# challenge and burns an attempt against the rate limit.
#
# sslip.io is a public wildcard DNS service that maps a dotted-or-dashed IP in
# the name straight back to that IP, which makes a real certificate possible
# without owning a domain. Replace it with your own name when you have one.
PUBLIC_HOSTNAME=37-27-249-33.sslip.io

# Optional. Caddy warns without one; the certificate issues either way.
ACME_EMAIL=
