# Deployment configuration. Copy to `.env.deploy`, fill in the two blanks, and
#
#   docker compose --env-file .env.deploy up -d --build
#
# `.env.deploy` is gitignored. Nothing in this file is a secret except
# ANTHROPIC_API_KEY — the x402 values are public chain parameters, and the
# service holds no signing keys of its own (see src/build/signing.py for why the
# APK ships unsigned).

# --- x402, Base Sepolia -------------------------------------------------------
# Verified end to end on this configuration: a real transaction, a real APK.
X402_TOKEN_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_CHAIN_ID=84532
X402_NETWORK=base-sepolia
X402_PRICE_ATOMIC=500000

# The address that receives payment. There is no default: a wrong value here
# sends every buyer's money somewhere you do not control, and an empty one makes
# the service refuse payment outright rather than accept it into the void.
X402_PAY_TO=

# Public facilitator, no auth. It submits the authorization on-chain and pays
# gas, which is what lets a buyer pay in USDC with no ETH. Leave it set: without
# it the service accepts signed promises it never settles, and /healthz will say
# so with `settlement: verification-only`.
X402_FACILITATOR_URL=https://facilitator.payai.network

# --- generation ---------------------------------------------------------------
# The service defaults to the Claude generator, so this is required for the
# deployment to produce anything. A sweep costs real money; see the README on
# what generation runs cost before pointing traffic at this.
ANTHROPIC_API_KEY=

# `template` is the deterministic generator: no API key, no spend, and it still
# exercises the whole pipeline through to an APK. Useful for a first deploy.
SUPERVISOR_GENERATOR=claude

# `debug` produces an installable APK. `release` produces an unsigned one the
# buyer signs with their own key, which is the honest artifact for resale but
# not installable as delivered.
SUPERVISOR_BUILD_MODE=debug

LOG_LEVEL=INFO
