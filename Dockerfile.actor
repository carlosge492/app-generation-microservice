# The Apify Actor image.
#
# Self-contained rather than `FROM appgen-base`, because Apify builds this on
# its own runners and cannot pull an image that only exists on our machine. That
# means the toolchain instructions below are duplicated from ./Dockerfile, which
# is a real risk: the whole promise of the service is that generated code
# compiles, and two images pinned to different SDKs would let the Actor and the
# hosted service claim the same guarantee while building differently.
#
# `test_the_two_images_pin_the_same_toolchain` fails if any pinned version here
# stops matching ./Dockerfile. Change one, change both.
#
# A cold build measured 5m30s and 2.61 GB, against Apify's 30-minute build
# timeout — the margin is why this approach is viable at all.
FROM python:3.12-slim-bookworm

# amd64 only: the Flutter Linux SDK is x64 and the Android build-tools ship
# x86_64 ELF binaries. Caught here rather than several minutes later inside
# Gradle, with an exec-format error that names none of this.
RUN arch="$(dpkg --print-architecture)"; \
    if [ "$arch" != "amd64" ]; then \
        echo "This image is amd64-only. Detected: $arch." >&2; \
        exit 1; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        openjdk-17-jdk-headless \
        unzip \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

ENV FLUTTER_VERSION=3.44.8 \
    FLUTTER_ROOT=/opt/flutter \
    ANDROID_SDK_ROOT=/opt/android \
    ANDROID_HOME=/opt/android \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${FLUTTER_ROOT}/bin:${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools:${PATH}"

RUN curl -fsSL --retry 3 \
        "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
        -o /tmp/flutter.tar.xz \
    && tar -xJf /tmp/flutter.tar.xz -C /opt \
    && rm /tmp/flutter.tar.xz

# The two `test` lines are the real check: `flutter doctor` exits 0 with pieces
# of the toolchain missing, and apksigner is what src/build/signing.py shells
# out to in order to prove a release APK is unsigned.
RUN curl -fsSL --retry 3 \
        "https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip" \
        -o /tmp/cmdline-tools.zip \
    && mkdir -p "${ANDROID_SDK_ROOT}/cmdline-tools" \
    && unzip -q /tmp/cmdline-tools.zip -d "${ANDROID_SDK_ROOT}/cmdline-tools" \
    && mv "${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools" "${ANDROID_SDK_ROOT}/cmdline-tools/latest" \
    && rm /tmp/cmdline-tools.zip \
    && yes | sdkmanager --licenses > /dev/null \
    && sdkmanager --install "platforms;android-36" "build-tools;36.0.0" "platform-tools" > /dev/null \
    && test -d "${ANDROID_SDK_ROOT}/platforms/android-36" \
    && test -x "${ANDROID_SDK_ROOT}/build-tools/36.0.0/apksigner"

# System-wide as root, before the user switch: a RUN after `USER` cannot write
# to the system site-packages, and that failure reads like a broken dependency.
ENV POETRY_VIRTUALENVS_CREATE=false \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml poetry.lock README.md ./
RUN pip install "poetry>=2.0" \
    && poetry install --only main --no-root \
    && pip install "apify>=2.0.0" \
    && python -c "import apify"

# Builds run unprivileged: the Flutter tool refuses some operations as root, and
# git reports "dubious ownership" on a checkout it does not own, which surfaces
# as a Flutter version error rather than a permissions one.
RUN useradd --create-home --shell /bin/bash builder \
    && mkdir -p /tmp/actor-build \
    && chown -R builder:builder /opt/flutter /opt/android /tmp/actor-build /app

USER builder
RUN git config --global --add safe.directory /opt/flutter \
    && flutter config --android-sdk "${ANDROID_SDK_ROOT}" --no-analytics \
    && flutter precache --android \
    && flutter --version

COPY --chown=builder:builder src ./src

# Apify gives the Actor a writable working directory but no mounted volume.
ENV BUILD_ROOT=/tmp/actor-build

# Runs once and exits rather than serving.
CMD ["python", "-m", "src.actor.main"]
