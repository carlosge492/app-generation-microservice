{
  "app_name": "Cupertino Reader",
  "package_name": "com.example.cupertinoreader",
  "description": "Requests the Cupertino theme rather than Material.",
  "theme": "cupertino",
  "models": [
    {
      "name": "Article",
      "collection": "articles",
      "fields": [{ "name": "headline", "label": "Headline", "type": "text" }]
    }
  ],
  "screens": [
    { "id": "articles", "title": "Articles", "kind": "list", "model": "Article" }
  ]
}
